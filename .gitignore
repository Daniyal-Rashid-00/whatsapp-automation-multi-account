# ============================================================
# CyberSolu Auto - WhatsApp Support Studio
# .gitignore - NEVER push these files to GitHub
# ============================================================

# ── DATABASE (Contains API keys, rules, settings, logins) ──
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── WHATSAPP SESSION DATA (Encryption keys, login creds - NEVER push!) ──
wa_engine/sessions/
wa_engine/sessions_backup/
wa_web_engine/sessions/
wa_web_engine/sessions_backup/
.cache/

# ── ENVIRONMENT & SECRETS ──
.env
.env.*
*.key
*.pem
*.secret
secrets.json
config.local.*

# ── PYTHON ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# ── VIRTUAL ENVIRONMENTS ──
venv/
.venv/
env/
ENV/
.env/

# ── PYTEST & TESTING ──
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ── LOGS ──
*.log
logs/

# ── IDE & EDITORS ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS FILES ──
.DS_Store
Thumbs.db
desktop.ini

# ── NODE (for Baileys/WA Engine) ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── DIST / BUILD OUTPUT ──
dist/
build/
*.spec

# ── MEDIA & TEMP UPLOADS ──
uploads/
temp/
tmp/
